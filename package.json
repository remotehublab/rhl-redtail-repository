{
  "name": "redtail-test-system",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots=all",
    "test:browser:all": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1"
  }
}
